<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Body Tracking SDK 네이티브 DLL이 x64 전용.
         Azure Kinect NuGet은 $(Platform)이 x64/x86인지 검사하므로 PlatformTarget만으로는 부족 -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>FemtoSkeletonAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 웹 화면 파일을 실행 폴더에 복사 (exe만 실행해도 웹이 뜨도록) -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Azure.Kinect.Sensor 1.4.x 를 함께 가져옵니다 -->
    <PackageReference Include="Microsoft.Azure.Kinect.BodyTracking" Version="1.1.2" />
  </ItemGroup>

  <!--
    Orbbec K4A Wrapper 교체:
    ../orbbec 폴더에 넣은 파일(k4a.dll, OrbbecSDK.dll, OrbbecSDKConfig*.xml 등)을
    빌드 후 출력 폴더에 덮어씁니다. NuGet이 넣은 Microsoft k4a.dll 대신 Orbbec 것이 쓰이게 됩니다.
  -->
  <Target Name="CopyOrbbecWrapper" AfterTargets="Build">
    <ItemGroup>
      <OrbbecFiles Include="$(MSBuildProjectDirectory)\..\orbbec\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\orbbec\README.txt;$(MSBuildProjectDirectory)\..\orbbec\VERSION.txt" />
    </ItemGroup>
    <!-- 하위 폴더(extensions\depthengine 등) 구조 유지: Orbbec SDK v2는 여기서 플러그인을 읽음 -->
    <Copy SourceFiles="@(OrbbecFiles)" DestinationFiles="@(OrbbecFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" Condition="'@(OrbbecFiles)' != ''" />
    <Warning Text="orbbec 폴더가 비어 있습니다. Femto Bolt를 쓰려면 Orbbec K4A Wrapper의 bin 파일을 orbbec 폴더에 넣으세요. (데모 모드는 그대로 동작)" Condition="'@(OrbbecFiles)' == ''" />
  </Target>

  <!--
    Body Tracking 런타임(DirectML, ONNX 모델 등)이 실행 폴더에 없으면
    Body Tracking SDK 설치 폴더에서 복사합니다. (이미 있는 파일은 건드리지 않음)
  -->
  <Target Name="CopyBodyTrackingRuntimeIfMissing" AfterTargets="Build" BeforeTargets="CopyOrbbecWrapper">
    <PropertyGroup>
      <BtSdkBin>$(ProgramFiles)\Azure Kinect Body Tracking SDK\sdk\windows-desktop\amd64\release\bin</BtSdkBin>
    </PropertyGroup>
    <ItemGroup>
      <BtRuntime Include="$(BtSdkBin)\k4abt.dll;$(BtSdkBin)\onnxruntime.dll;$(BtSdkBin)\directml.dll;$(BtSdkBin)\dnn_model_2_0_op11.onnx;$(BtSdkBin)\dnn_model_2_0_lite_op11.onnx" />
    </ItemGroup>
    <Copy SourceFiles="%(BtRuntime.FullPath)" DestinationFolder="$(OutDir)"
          Condition="Exists('%(BtRuntime.FullPath)') And !Exists('$(OutDir)%(BtRuntime.Filename)%(BtRuntime.Extension)')" />
  </Target>

  <Target Name="CopyOrbbecWrapperOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <OrbbecPubFiles Include="$(MSBuildProjectDirectory)\..\orbbec\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\orbbec\README.txt;$(MSBuildProjectDirectory)\..\orbbec\VERSION.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(OrbbecPubFiles)" DestinationFiles="@(OrbbecPubFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" Condition="'@(OrbbecPubFiles)' != ''" />
  </Target>

</Project>
